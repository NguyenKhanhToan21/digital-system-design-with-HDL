transcript on
if {[file exists gate_work]} {
	vdel -lib gate_work -all
}
vlib gate_work
vmap work gate_work

vlog -vlog01compat -work work +incdir+. {Lab4.vo}

vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab4 {E:/UIT/HDL/LAB/Lab4/ALU_32bit_tb.v}

vsim -t 1ps +transport_int_delays +transport_path_delays -L cycloneii_ver -L gate_work -L work -voptargs="+acc"  tb_ALU_32bit

add wave *
view structure
view signals
run -all
