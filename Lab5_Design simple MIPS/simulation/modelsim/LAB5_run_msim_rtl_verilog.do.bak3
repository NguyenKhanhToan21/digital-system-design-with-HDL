transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/dual_port_RAM.v}
vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/mux_5bit.v}
vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/RF.v}
vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/ALU.v}
vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/Datapath.v}
vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/mux_32bit.v}

vlog -vlog01compat -work work +incdir+E:/UIT/HDL/LAB/Lab5 {E:/UIT/HDL/LAB/Lab5/Datapath_tb.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneii_ver -L rtl_work -L work -voptargs="+acc"  Datapath_tb

add wave *
view structure
view signals
run -all
